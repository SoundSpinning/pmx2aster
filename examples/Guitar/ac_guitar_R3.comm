    LIAISON_MAIL = (
        _F( # TIED pair #1
            GROUP_MA_MAIT = 'body_2_strap_back_mst_els',
            GROUP_NO_ESCL = 'sm_body_2_strap_back_slv',
            TYPE_RACCORD = "MASSIF",
            DDL = dof_3, 
            # DISTANCE_MAX = 0.1,  ## only use for edge cases
        ),
        _F( # TIED pair #2
            GROUP_MA_MAIT = 'fretboard_2_frets_mst_els',
