            TYPE_RACCORD = "MASSIF",
            DDL = dof_3, 
            # DISTANCE_MAX = 0.1,  ## only use for edge cases
        ),
        _F( # TIED pair #10
            GROUP_MA_MAIT = 'neck_2_top_bridge_mst_els',
            GROUP_NO_ESCL = 'sm_neck_2_top_bridge_slv',
            TYPE_RACCORD = "MASSIF",
            DDL = dof_3, 
            # DISTANCE_MAX = 0.1,  ## only use for edge cases
        ),
        _F( # TIED pair #11
            GROUP_MA_MAIT = 'body_to_neck_mst_els',
            GROUP_NO_ESCL = 'sm_body_to_neck_slv',
            TYPE_RACCORD = "MASSIF",
