        TOUT_ORDRE = 'OUI',
        RESULTANTE = ('DX' ,'DY' ,'DZ' , ),
        MOMENT = ('DRX' ,'DRY' ,'DRZ' , ),
        POINT = ( 0., 0., 0., ),   ## wrt which the moments are calculated
        OPERATION = 'EXTRACTION',
    ),
);

# CHECK on sum of TIED loads on neck_2_strap_fr:
