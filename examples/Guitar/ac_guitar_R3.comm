# -----
# BOLTS: 
# -----
# ( 1 ) bolt(s) loads tables: head & thread sides.
bolt_forces = POST_RELEVE_T(
    ACTION=_F(
        INTITULE = 'TOTAL BOLTs F & M',
        GROUP_NO = bolt_srf_head_sets,
        RESULTAT = multi_LC,
        NOM_CHAM = 'FORC_NODA',
        TOUT_ORDRE = 'OUI',
        RESULTANTE = dof_3,
        MOMENT = ('DRX' ,'DRY' ,'DRZ' , ),
        ## Location wrt which the moments are calculated
        POINT = ( 0 , 0 , 0 , ),
        OPERATION = 'EXTRACTION',
    ),
);

thread_forces = POST_RELEVE_T(
    ACTION=_F(
        INTITULE = 'TOTAL THREADs F & M',
        GROUP_NO = bolt_srf_thread_sets,
        RESULTAT = multi_LC,
        NOM_CHAM = 'FORC_NODA',
        TOUT_ORDRE = 'OUI',
        RESULTANTE = dof_3,
        MOMENT = ('DRX' ,'DRY' ,'DRZ' , ),
        ## Location wrt which the moments are calculated
        POINT = ( 0 , 0 , 0 , ),
        OPERATION = 'EXTRACTION',
    ),
);

# -------------
# TABLES export
# -------------
# CHECK on sum of ( 1 ) BOLT loads:
# bolt head side
IMPR_TABLE (
    TABLE = bolt_forces,
    NOM_PARA = table_sums_6,
    FORMAT_R = 'G12.5',
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA ="""
            Total Sum: ( 1 ) BOLTs Head Forces & Moments
            ===========================================\n""",
    UNITE = 8, 
);

# bolt thread side
IMPR_TABLE (
    TABLE = thread_forces,
    NOM_PARA = table_sums_6,
    FORMAT_R = 'G12.5',
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
            Total Sum: ( 1 ) THREADs Forces & Moments
            ========================================\n""",
    UNITE = 8, 
);


# 
# Post results HACK (very ugly!) 
# MED --> PV results so that deformed shapes + any results on assemblies can be plotted.
# 
all_steps = multi_LC.LIST_PARA()['NUME_ORDRE'];
print(all_steps);
time_steps = multi_LC.LIST_PARA()['INST'];
print(time_steps);

# Combine all stresses into a single field, 
# so that Paraview can plot deformed shapes + any Stress variable.
#                      ---------------------------------
asse_list = []

# for inc in range(len(all_steps)):
for inc in all_steps:
    # time = time_steps[inc-1] ##  for MECA_STATIQUE steps
    # time = time_steps[inc]   ##  for STAT_NON_LIN steps; dunno why, but code_aster changes loadcase ID integers!
    time = time_steps[inc]
    try:
        ## Extract stress tensor & elem forces at all nodes
        sief = multi_LC.getField('SIEF_NOEU', inc)
        ## Extract von Mises, etc stress fields - some nodes
        sieq = multi_LC.getField('SIEQ_NOEU', inc)
        ## Extract shells stress fields
        # s_sief = sh_sief.getField('SIGM_NOEU', inc)
        # s_sieq = sh_sieq.getField('SIEQ_NOEU', inc)
        
        # Combine all stress vars into one field
        s_all = CREA_CHAMP(
            OPERATION = 'ASSE',
            TYPE_CHAM = 'NOEU_SIEF_R',
            MAILLAGE = mesh,
            ASSE=(
                _F(CHAM_GD = sief, TOUT = 'OUI', CUMUL='OUI', COEF_R=1.0, ),  
                _F(CHAM_GD = sieq, TOUT = 'OUI', CUMUL='OUI', COEF_R=1.0, ),
                ## SHELLS
                # _F(CHAM_GD = s_sief, TOUT = 'OUI', CUMUL='OUI', COEF_R=1.0, ),
                # _F(CHAM_GD = s_sieq, TOUT = 'OUI', CUMUL='OUI', COEF_R=1.0, ),
            ),
        );
        # Add to ASSE list
        asse_list.append(_F(CHAM_GD = s_all, INST = time, MODELE = model_assy, ))
    except Exception as e:
        print(f'Error at step {time}: {e}')
        continue

# the copy of the results concept is required if we need a 'base' for restarts.
# if we leave the post calcs below inside `multi_LC`, any restart after will crash.
# there you go, the fun of working with code_aster, crazy ...
post_multi_LC = COPIER (CONCEPT = multi_LC);

# Merge results
post_multi_LC = CREA_RESU(
    reuse = post_multi_LC,
    RESULTAT = post_multi_LC,
    OPERATION = 'AFFE',
    TYPE_RESU = 'EVOL_NOLI',
    NOM_CHAM = "SIEF_NOEU",
    AFFE = tuple(asse_list),
);

# Results variable names:
s_vars = ('SIXX', 'SIYY', 'SIZZ', 'SIXY', 'SIXZ', 'SIYZ', 'N', 'VY', 'VZ', 'MT', 'MFY', 'MFZ', \
          'VMIS', 'VMIS_SG', );    ## ('TRESCA', 'PRIN_1', 'PRIN_2', 'PRIN_3', );
nvh_vars = ('N', 'VY', 'VZ', 'MT', 'MFY', 'MFZ', 'VMIS', 'VMIS_SG', );
spr_vars = ('N', 'VY', 'VZ', 'MT', 'MFY', 'MFZ',)

# ------
# EXPORT STATIC (MED) results --> binary (.rmed) file, reads in Paraview.
# ------
IMPR_RESU(
    FORMAT = "MED",
    UNITE = 80,
    RESU = (
        _F( RESULTAT = post_multi_LC, 
            NOM_RESU_MED = '1_Stat',
            NOM_CHAM = ('DEPL', ),
            # NOM_CHAM = ('DEPL', 'REAC_NODA', 'FORC_NODA', ),
          ),
        _F( RESULTAT = post_multi_LC, 
            NOM_RESU_MED = '1_Stat',
            NOM_CHAM = ('SIEF_NOEU'),
            NOM_CMP = s_vars
          ),
    ),
);

# Nodal results at couplings, masses & springs to plot force/reaction vectors
IMPR_RESU(
    FORMAT = "MED",
    UNITE = 81,
    RESU = (
        _F( RESULTAT = post_multi_LC, 
            GROUP_MA =  ref_RP_sets,
            NOM_RESU_MED = '1_Stat',
            NOM_CHAM = ('DEPL', 'REAC_NODA', 'FORC_NODA', ),
          ),
        _F( RESULTAT = post_multi_LC, 
            GROUP_MA =  ref_RP_sets,
            NOM_RESU_MED = '1_Stat',
            NOM_CHAM = ('SIEF_NOEU'),
            NOM_CMP = spr_vars
          ),
    ),
);
# not needed in the 'base' results, so delete.
DETRUIRE(NOM = (post_multi_LC, s_all, sief, sieq));


# ----------------------
# STEP_3: Modal Analysis
# ----------------------

# Setting the right matrices for a modal STEP
ASSEMBLAGE(
    MODELE = model_assy,
    CHAM_MATER = materials, 
    CARA_ELEM = element_props,
    CHARGE = (fix_STEP_1, soft_coups, tied_mod, ),
    ### use below for a free-free modal; i.e. check for 6 RBModes at ~0Hz.
    # CHARGE = (soft_coups, tied_mod, ),  
    MATR_ASSE = (
        _F( MATRICE = CO('MASS'), OPTION = "MASS_MECA", ),
        _F( MATRICE = CO('RIGI'), OPTION = "RIGI_MECA", ),
    ),
    NUME_DDL = CO('numdof'),
);

# Modal analysis setup
modes = CALC_MODES(
    MATR_RIGI = RIGI,
    MATR_MASS = MASS,
    OPTION = "PLUS_PETITE",
    CALC_FREQ = _F( 
        NMAX_FREQ = 10,       ### Number of modes
        NMAX_ITER_SHIFT = 3,
        PREC_SHIFT = 0.05,
        ### Below Important! to capture negative (~0Hz) rigid body modes.
        SEUIL_FREQ = 10,     ### Shift freq parameter, will turn to -10 in solve.
    ),
    SOLVEUR_MODAL = _F( METHODE = 'SORENSEN') ,    ### faster than Lanczos
    # SOLVEUR_MODAL = _F( METHODE = 'TRI_DIAG', MODE_RIGIDE = 'OUI',) ,   ### Lanczos solver
    SOLVEUR = _F(
        RESI_RELA = -1, NB_RHS = 10,
        METHODE='MUMPS', GESTION_MEMOIRE = 'AUTO', PCENT_PIVOT = 10, 
    ),
    VERI_MODE = _F(
        PREC_SHIFT = 0.05, SEUIL = 1e-06,
        STOP_ERREUR = 'NON', STURM = 'NON', 
    ),
    STOP_BANDE_VIDE = 'NON',
);

# Calculate Total_SE (TSE) per component (elem set), per mode.
mod_total_SE = POST_ELEM(
    ENER_POT = _F( GROUP_MA = assy_ener , ),
    RESULTAT = modes,
);

# Export results --> table in text (.dat) file
# Natural Freqs (Hz) + modal participation factors...
mod_table = RECU_TABLE (
   CO = modes,
   NOM_PARA = table_modal_out,
   TITRE = 'Modal Results Table',
);

IMPR_TABLE (
    TABLE = mod_table,
    FORMAT_R = 'G12.5', 
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
    Modal (Freqs(Hz), Participation Factors, Effective Mass)
    ========================================================\n""",
    UNITE = 8, 
);

IMPR_TABLE (
    TABLE = mod_total_SE,
    FORMAT_R = 'G12.5', 
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
            Total Strain Energy - Modal (TSE - ALL)
            =======================================\n""",
    UNITE = 8, 
);

# export results --> binary .rmed file
IMPR_RESU (
    FORMAT = 'MED', 
    UNITE = 80,
    RESU = _F(
        RESULTAT = modes, 
        NOM_CHAM = 'DEPL', 
        NOM_CHAM_MED='2_Modal',
    ),
);

# ----------------------
# STEP_4: Modal Analysis + preload
# ----------------------

pre_stress_1 = CREA_CHAMP(
    TYPE_CHAM="ELGA_SIEF_R", OPERATION="EXTR", RESULTAT=multi_LC, NUME_ORDRE=2, NOM_CHAM="SIEF_ELGA"
);

# Setting the right matrices for a modal STEP
ASSEMBLAGE(
    MODELE = model_assy,
    CHAM_MATER = materials, 
    CARA_ELEM = element_props,
    CHARGE = (fix_STEP_1, soft_coups, tied_mod, ),
    ### use below for a free-free modal; i.e. check for 6 RBModes at ~0Hz.
    # CHARGE = (soft_coups, tied_mod, ),  
    MATR_ASSE = (
        _F( MATRICE = CO('MASS'), OPTION = "MASS_MECA", ),
        _F( MATRICE = CO('RIGI'), OPTION = "RIGI_MECA", ),
        _F(MATRICE=CO('KASGEO'), OPTION="RIGI_GEOM", SIEF_ELGA=pre_stress_1),
    ),
    NUME_DDL = CO('numdof'),
);

K_full = COMB_MATR_ASSE(
    COMB_R=(
        _F(MATR_ASSE=KASGEO, COEF_R=1.0),
        _F(MATR_ASSE=RIGI, COEF_R=1.0),
    ),
);

# Modal analysis setup
modes_pre = CALC_MODES(
    MATR_RIGI = K_full,
    MATR_MASS = MASS,
    OPTION = "PLUS_PETITE",
    CALC_FREQ = _F( 
        NMAX_FREQ = 10,       ### Number of modes
        NMAX_ITER_SHIFT = 3,
        PREC_SHIFT = 0.05,
        ### Below Important! to capture negative (~0Hz) rigid body modes.
        SEUIL_FREQ = 10,     ### Shift freq parameter, will turn to -10 in solve.
    ),
    SOLVEUR_MODAL = _F( METHODE = 'SORENSEN') ,    ### faster than Lanczos
    # SOLVEUR_MODAL = _F( METHODE = 'TRI_DIAG', MODE_RIGIDE = 'OUI',) ,   ### Lanczos solver
    SOLVEUR = _F(
        RESI_RELA = -1, NB_RHS = 10,
        METHODE='MUMPS', GESTION_MEMOIRE = 'AUTO', PCENT_PIVOT = 10, 
    ),
    VERI_MODE = _F(
        PREC_SHIFT = 0.05, SEUIL = 1e-06,
        STOP_ERREUR = 'NON', STURM = 'NON', 
    ),
    STOP_BANDE_VIDE = 'NON',
);

# Calculate Total_SE (TSE) per component (elem set), per mode.
mod_total_SE = POST_ELEM(
    ENER_POT = _F( GROUP_MA = assy_ener , ),
    RESULTAT = modes_pre,
);

# Export results --> table in text (.dat) file
# Natural Freqs (Hz) + modal participation factors...
mod_table = RECU_TABLE (
   CO = modes_pre,
   NOM_PARA = table_modal_out,
   TITRE = 'Modal Results Table',
);

IMPR_TABLE (
    TABLE = mod_table,
    FORMAT_R = 'G12.5', 
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
    Preloaded Modal (Freqs(Hz), Participation Factors, Effective Mass)
    ==================================================================\n""",
    UNITE = 8, 
);

IMPR_TABLE (
    TABLE = mod_total_SE,
    FORMAT_R = 'G12.5', 
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
            Preloaded - Total Strain Energy - Modal (TSE - ALL)
            ===================================================\n""",
    UNITE = 8, 
);

# export results --> binary .rmed file
IMPR_RESU (
    FORMAT = 'MED', 
    UNITE = 80,
    RESU = _F(
        RESULTAT = modes_pre, 
        NOM_CHAM = 'DEPL', 
        NOM_CHAM_MED='3_Modal_pre',
    ),
);

# ===
# END of the input deck
# ===
FIN();
