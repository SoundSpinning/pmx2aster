        ),
        _F( # TIED pair #13
            GROUP_MA_MAIT = 'sad_plate_2_sad_mst_els',
            GROUP_NO_ESCL = 'sm_sad_plate_2_sad_slv',
            TYPE_RACCORD = "MASSIF",
