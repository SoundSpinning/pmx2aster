            TYPE_RACCORD = "MASSIF",
            DDL = ('DY', 'DZ'), 
            # DDL = dof_3, 
            # DISTANCE_MAX = 0.1,  ## only use for edge cases
        ),
        _F( # TIED pair #17
            GROUP_MA_MAIT = 'head_rod_to_neck_mst_els',
            GROUP_NO_ESCL = 'sm_head_rod_to_neck_slv',
            TYPE_RACCORD = "MASSIF",
            DDL = dof_3, 
            # DISTANCE_MAX = 0.05,  ## only use for edge cases
        ),
