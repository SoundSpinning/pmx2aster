 #  "ac_guitar_R3.inp" model HEADING:
 # Hash: w4IfVAQ3, Date: 11/21/2025, Unit system: MM_TON_S_C
 # ac_guitar_R3.ppx
 # st#1: truss rod tension preload
 # st#2: fix truss road preload + strings tension + small pull in -Z
 # Modal#1: no pretension
 # Modal#2: (strings + rod) pretension (st#2)
 # ------------------------

# =====
# START of the ASTER input deck
# =====
DEBUT(LANG = 'EN');

#             ----------
# Reading the INPUT MESH
#             ----------
# Reading the mesh in ASTER (ascii) format (logical unit 21).
# ASCII format preferred for the input mesh to allow quick hand edits on sets, etc in a text editor.
# 
mesh = LIRE_MAILLAGE ( 
    FORMAT = "ASTER", 
    INFO = 1,
    UNITE = 21 ,
);

#        --------
# Create NEW SETS:
#        --------
DEFI_GROUP(
    reuse = mesh, MAILLAGE = mesh,
    CREA_GROUP_MA = (
        _F(
            NOM = 'tetra10_els', 
            TOUT = "OUI", 
            TYPE_MAILLE = "TETRA10",
        ),
        _F(# TIED #1 elem set off a Master Surface
            NOM = 'body_2_strap_back_mst_els', 
