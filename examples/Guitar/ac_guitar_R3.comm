            =========================================\n""",
    UNITE = 8, 
);

# SUM of ALL input forces/moments per DoF.
sum_loads = POST_RELEVE_T(
    ACTION=_F(
        INTITULE = 'TOTAL F & M',
        GROUP_NO = load_all,
        RESULTAT = multi_LC,
        NOM_CHAM = 'FORC_NODA',
        TOUT_ORDRE = 'OUI',
        RESULTANTE = dof_3,
        MOMENT = ('DRX' ,'DRY' ,'DRZ' , ),
        ## Location wrt which the moments are calculated
        POINT = ( 0 , 0 , 0 , ),
        OPERATION = 'EXTRACTION',
    ),
);

load_disp = POST_RELEVE_T(
    ACTION=_F(
        INTITULE = 'Disps / Rots',
        GROUP_NO = load_sets,
        RESULTAT = multi_LC,
        NOM_CHAM = 'DEPL',
        NOM_CMP = dof_6,
        OPERATION = 'EXTRACTION',
    ),
);

# -------------
