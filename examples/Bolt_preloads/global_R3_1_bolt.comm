sum_loads = POST_RELEVE_T(
    ACTION=_F(
        INTITULE = 'TOTAL F & M',
        GROUP_NO = load_all,
        RESULTAT = multi_LC,
        NOM_CHAM = 'FORC_NODA',
        TOUT_ORDRE = 'OUI',
        RESULTANTE = dof_3,
        MOMENT = ('DRX' ,'DRY' ,'DRZ' , ),
