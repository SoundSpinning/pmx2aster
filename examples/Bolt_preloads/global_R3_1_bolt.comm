        OPERATION = 'EXTRACTION',
    ),
);

load_disp = POST_RELEVE_T(
    ACTION=_F(
        INTITULE = 'Disps / Rots',
        GROUP_NO = load_sets,
        RESULTAT = multi_LC,
        NOM_CHAM = 'DEPL',
        NOM_CMP = dof_6,
        OPERATION = 'EXTRACTION',
    ),
);

# -------------
