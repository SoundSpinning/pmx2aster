# );
              
# This is just a test on all nodes in model, since sometimes the sum above doesn't make sense.
## check run time for large models b4 switching this on.
all_sum_reactions = POST_RELEVE_T(
    ACTION=_F(
        INTITULE = 'ALL TOTAL RF & RM',
        GROUP_NO = 'all_nodes',
        RESULTAT = multi_LC,
        NOM_CHAM = 'REAC_NODA',
        TOUT_ORDRE = 'OUI',
        RESULTANTE = dof_3,
        MOMENT = ('DRX' ,'DRY' ,'DRZ' , ),
        ## Location wrt which the moments are calculated
        POINT = ( 0 , 0 , 0 , ),
        OPERATION = 'EXTRACTION',
    ),
);

