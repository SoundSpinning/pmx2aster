 #  "sub_stat_R2_radar.inp" model HEADING:
 # Hash: Dg9gbjcB, Date: 10/03/2025, Unit system: MM_TON_S_C
 # ## sub_stat_R2_radar - SUBMODEL
 # ## Statics - 9LCs - Restart off Global

##                       --------
## This model setup is a SUBMODEL, and runs as a restart from a global model
##                       --------
## Pls make sure to have all loads and/or constraints applicable to the local mesh(es)
## AND that you have restart files from the global model, `base` folder.
##

# =====
# START of the ASTER input deck
# =====
POURSUITE();

#             ----------
# Reading the INPUT MESH
#             ----------
# Reading the mesh in ASTER (ascii) format (logical unit 21).
# ASCII format preferred for the input mesh to allow quick hand edits on sets, etc in a text editor.
# 
mesh = LIRE_MAILLAGE ( 
    FORMAT = "ASTER", 
    INFO = 1,
    UNITE = 21 ,
);

#        --------
# Create NEW SETS:
#        --------
DEFI_GROUP(
    reuse = mesh, MAILLAGE = mesh,
    CREA_GROUP_MA = (
        _F(
            NOM = 'tetra10_els', 
            TOUT = "OUI", 
            TYPE_MAILLE = "TETRA10",
        ),
    ),
);

# Generate node and elem (2 x) sets for the complete assembly
DEFI_GROUP(
    reuse = mesh, MAILLAGE = mesh,
    CREA_GROUP_MA = (
        _F(
            NOM = 'all_els', 
            TOUT = "OUI", 
        ),
                    ),
    CREA_GROUP_NO = (
        _F(
            NOM = 'all_nodes',
            GROUP_MA = 'all_els', 
        ),
    ),
);

#                    ---------------------
# Auto-build generic SETS to form TEMPLATEs in input decks
#                    ---------------------
# add all point MASS elem sets, careful if only mass (DIS_T) and/or inertia(s) required (DIS_TR).
##  ( 0 ) sets
mass_els = ();

# add all SHELL element sets
##  ( 0 ) sets
shell_els = ();

# add all SPRINGs (DIS_TR) elem sets, careful if only to-ground (K_TR_D_N) or between 2 nodes (K_TR_D_L)
## ( 0 ) springs-to-ground
spr_1_els = ();  
## ( 0 ) 2-Node springs
spr_2_els = ();  

# add all element sets by COMPONENTs here, useful for output tables into (.dat) text file for assemblies.
# e.g. mass / inertia breakdowns, and Total Strain Energy (TSE) contributions per part.
## all structural elements: ( 3 ) sets
assy_els = ('sub_azi_house_els', 'sub_frame_els', 'sub_base_els'); 
## all mass / inertia elements: ( 3 ) sets
assy_mass = ('sub_azi_house_els', 'sub_frame_els', 'sub_base_els');  
## all structural elements for total_SE calcs: ( 3 ) sets
assy_ener = ('sub_azi_house_els', 'sub_frame_els', 'sub_base_els');  

# Add CONSTRAINED sets here, so that total REACTION(s) output always works in a generic form.
# NOTE that for couplings (_RBE3 & _SOLIDE) sums don't work in tables, all zero values;
# we need to use the node_sets in surfaces involved, another code_aster mistery ...
##  ( 0 ) sets
fix_sets = ();
fix_surfs = ();
fix_all = ();

# Add LOADING sets here, so that force / moments may be applied in a generic form.
# Also, for SUMs of input force / moment tables for sanity checks. See above for couplings.
##  ( 0 ) sets
load_sets = ();
load_surfs = ();
load_all = ();

# list COUPLING sets ([surf_set, ref_node_set]) if any involved, just for reference and sanity checks:
##  ( 0 ) rigid couplings
pairs_rigid_coups = [];
##  ( 0 ) soft couplings
pairs_soft_coups = [];
##  ( 0 ) couplings ref RP elem_sets
ref_RP_sets = ();

#                      ------------------
# Generic (structural) OUTPUTS and/or DoF used throughout the input deck:
#                      ------------------
dof_6 =        ('DX' ,'DY' ,'DZ', 'DRX' ,'DRY' ,'DRZ' , );
dof_3 =        ('DX' ,'DY' ,'DZ', );

coup_dof_3 =   ('DX-DY-DZ', );
coup_dof_6 =   ('DX-DY-DZ-DRX-DRY-DRZ', );

table_mass =   ('LIEU', 'CDG_X', 'CDG_Y', 'CDG_Z', 'MASSE', 'IX_G', 'IY_G', 'IZ_G');

table_dof_3 =  ('NOEUD', 'NUME_ORDRE', 'DX' ,'DY' ,'DZ' , );
table_dof_6 =  ('NOEUD', 'NUME_ORDRE', 'DX' ,'DY' ,'DZ' , 'DRX' ,'DRY' ,'DRZ' , );

table_sums_3 = ('NUME_ORDRE', 'NOM_CHAM', 'RESULT_X', 'RESULT_Y', 'RESULT_Z', );
table_sums_6 = ('NUME_ORDRE', 'NOM_CHAM', 'RESULT_X', 'RESULT_Y', 'RESULT_Z', \
                'MOMENT_X', 'MOMENT_Y', 'MOMENT_Z', );

# modal info to write to (.dat) text results file:
table_modal_out = ('FREQ', 'FACT_PARTICI_DX', 'FACT_PARTICI_DY', 'FACT_PARTICI_DZ', \
                           'MASS_EFFE_DX', 'MASS_EFFE_DY', 'MASS_EFFE_DZ', \
                           'MASS_GENE', 'RIGI_GENE', );


# Print in .msg file ALL node/elem sets in the model (set_name, n_items) for sanity checks.
print(f"""
ALL Node_sets:
=============
{mesh.LIST_GROUP_NO()}

ALL Element_sets:
================
{mesh.LIST_GROUP_MA()}
""");


# -----------
# MODEL SETUP: assign domain types by auto-generic sets
# -----------
sub_model_assy = AFFE_MODELE(
    MAILLAGE = mesh,
    AFFE = (
        _F( # SOLID parts
            GROUP_MA = assy_els,
            PHENOMENE = "MECANIQUE",
            MODELISATION = "3D", 
        ),
   ),
);

# ---------
# MATERIALS:
# ---------
Aluminium = DEFI_MATERIAU(
    ELAS = 
        _F(
            E = 73000,
            NU = 0.33, 
            RHO = 2.78E-09,
            ALPHA = 0,
        ),
);

# ----------
# ASSIGNMENT of materials:
# ----------
materials = AFFE_MATERIAU(
    MAILLAGE = mesh,
    AFFE = (
        _F( # SOLID part materials
            GROUP_MA = 'sub_azi_house_els',
            MATER = Aluminium, 
        ),
        _F( # SOLID part materials
            GROUP_MA = 'sub_frame_els',
            MATER = Aluminium, 
        ),
        _F( # SOLID part materials
            GROUP_MA = 'sub_base_els',
            MATER = Aluminium, 
        ),
    ),
);

# -----------
# CONSTRAINTS: 
# -----------
# !!!!!!!!!!!!!!!!
#   NO constraints found; pls check you have spring(s)-to-ground to hold the FEA assembly up.
# !!!!!!!!!!!!!!!!
                 
# If this is a Submodel, make sure you have all loads and/or constraints applicable 
# to the local mesh, on top of the submodel BCs in the step definition(s).

# -----
# LOADS: 
# -----
load_STEP_7 = AFFE_CHAR_MECA(
    MODELE = sub_model_assy,
    PESANTEUR = _F(
        # GROUP_MA = elem_set,  ## default: apply to all, inc. point-masses
        GRAVITE = 1000,
        DIRECTION = (1, 0, 0),
    ),
);

load_STEP_8 = AFFE_CHAR_MECA(
    MODELE = sub_model_assy,
    PESANTEUR = _F(
        # GROUP_MA = elem_set,  ## default: apply to all, inc. point-masses
        GRAVITE = 1000,
        DIRECTION = (0, 1, 0),
    ),
);

load_STEP_9 = AFFE_CHAR_MECA(
    MODELE = sub_model_assy,
    PESANTEUR = _F(
        # GROUP_MA = elem_set,  ## default: apply to all, inc. point-masses
        GRAVITE = 1000,
        DIRECTION = (0, 0, 1),
    ),
);

 
# --------------------------------------
# STEP_1 to STEP_9: Linear Statics - 9 x loadcases
# --------------------------------------
#
# [ K ] matrix re-use when using a single set of constraints; i.e. fast linear solving.
#
# setup AMPLITUDE curves (tables) for solve time increments, period and each of the loadcases
#             -------------
# Setup solve time stepping (increments):
#             -------------
step_incs = DEFI_LIST_REEL (
    TITRE = 'step_incs',
    DEBUT = 1,
    INTERVALLE = 
        _F(
            JUSQU_A = 9 , ## time period
            PAS = 1,   ## time increment
        ),
    INFO = 2,
);

# ----------------
# AMPLITUDE curves for each load vs step_incs:
# ----------------
amp_load_STEP_1 = DEFI_FONCTION (
    TITRE = 'load_STEP_1',
    NOM_PARA = "INST",
    VALE = (
        0, 0,
        1, 1,
        2, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_2 = DEFI_FONCTION (
    TITRE = 'load_STEP_2',
    NOM_PARA = "INST",
    VALE = (
        1, 0,
        2, 1,
        3, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_3 = DEFI_FONCTION (
    TITRE = 'load_STEP_3',
    NOM_PARA = "INST",
    VALE = (
        2, 0,
        3, 1,
        4, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_4 = DEFI_FONCTION (
    TITRE = 'load_STEP_4',
    NOM_PARA = "INST",
    VALE = (
        3, 0,
        4, 1,
        5, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_5 = DEFI_FONCTION (
    TITRE = 'load_STEP_5',
    NOM_PARA = "INST",
    VALE = (
        4, 0,
        5, 1,
        6, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_6 = DEFI_FONCTION (
    TITRE = 'load_STEP_6',
    NOM_PARA = "INST",
    VALE = (
        5, 0,
        6, 1,
        7, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_7 = DEFI_FONCTION (
    TITRE = 'load_STEP_7',
    NOM_PARA = "INST",
    VALE = (
        6, 0,
        7, 1,
        8, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_8 = DEFI_FONCTION (
    TITRE = 'load_STEP_8',
    NOM_PARA = "INST",
    VALE = (
        7, 0,
        8, 1,
        9, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_9 = DEFI_FONCTION (
    TITRE = 'load_STEP_9',
    NOM_PARA = "INST",
    VALE = (
        8, 0,
        9, 1,
        10, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);


## --------
## SUBMODEL setup
## --------

# Global to Submodel interpolation
sub_disp = PROJ_CHAMP(
    METHODE = "COLLOCATION",
    RESULTAT = multi_LC,      ### results from `base` global model
    MODELE_1 = model_assy,
    MODELE_2 = sub_model_assy,
    NOM_CHAM = ("DEPL"),
    VIS_A_VIS = (
        _F(GROUP_MA_1 = 'frame_els', GROUP_NO_2 = 'cut_frame'),
        _F(GROUP_MA_1 = 'azi_house_els', GROUP_NO_2 = 'cut_azi_house'),
        _F(GROUP_MA_1 = 'base_els', GROUP_NO_2 = 'cut_base'),
    ),
);

# -------                     -------------
# Statics: Submodel solve via MECA_STATIQUE
# -------                     -------------
# Generation of submodel BCs and solving steps for ( 9 ) LCs: 

# Loadcase # 1:
# Submodel disps
sub_disp_1 = CREA_CHAMP(
    TYPE_CHAM = "NOEU_DEPL_R", OPERATION = "EXTR", RESULTAT = sub_disp, NOM_CHAM = "DEPL", NUME_ORDRE = 1,);

# Generate Submodel constraints
sub_fix_1 = AFFE_CHAR_MECA(MODELE = sub_model_assy, CHAMNO_IMPO = _F(CHAM_NO = sub_disp_1, COEF_IMPO = 1.0),);
    
multi_LC = MECA_STATIQUE( 
    MODELE = sub_model_assy,
    CHAM_MATER = materials,
    EXCIT = (
        _F(CHARGE = sub_fix_1, TYPE_CHARGE = 'FIXE_CSTE', FONC_MULT = amp_load_STEP_1),
    ),
    INST = 1,         ### time step, i.e. LC to solve
    OPTION = 'SANS',    ### turn off gaussian points results, see CALC_CHAMP
    ### turn off auto checks, get results for debugging
    SOLVEUR = _F( 
        RESI_RELA = -1, STOP_SINGULIER = 'NON',
        METHODE='MUMPS', GESTION_MEMOIRE = 'AUTO',
        PCENT_PIVOT = 10, NPREC = -1,   ### default: NPREC=8 | it can hold models up artifitially!
    ),
    TITRE = 'multi_LCs',
);

# Loadcase # 2:
# Submodel disps
sub_disp_2 = CREA_CHAMP(
    TYPE_CHAM = "NOEU_DEPL_R", OPERATION = "EXTR", RESULTAT = sub_disp, NOM_CHAM = "DEPL", NUME_ORDRE = 2,);

# Generate Submodel constraints
sub_fix_2 = AFFE_CHAR_MECA(MODELE = sub_model_assy, CHAMNO_IMPO = _F(CHAM_NO = sub_disp_2, COEF_IMPO = 1.0),);
    
multi_LC = MECA_STATIQUE( 
    reuse = multi_LC,
    RESULTAT = multi_LC,
    MODELE = sub_model_assy,
    CHAM_MATER = materials,
    EXCIT = (
        _F(CHARGE = sub_fix_2, TYPE_CHARGE = 'FIXE_CSTE', FONC_MULT = amp_load_STEP_2),
    ),
    INST = 2,         ### time step, i.e. LC to solve
    OPTION = 'SANS',    ### turn off gaussian points results, see CALC_CHAMP
    ### turn off auto checks, get results for debugging
    SOLVEUR = _F( 
        RESI_RELA = -1, STOP_SINGULIER = 'NON',
        METHODE='MUMPS', GESTION_MEMOIRE = 'AUTO',
        PCENT_PIVOT = 10, NPREC = -1,   ### default: NPREC=8 | it can hold models up artifitially!
    ),
    TITRE = 'multi_LCs',
);

# Loadcase # 3:
# Submodel disps
