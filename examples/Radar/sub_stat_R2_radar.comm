IMPR_TABLE (
    TABLE = total_mass,
    NOM_PARA = table_mass,
    FORMAT_R = '1G10.5',
    COMMENTAIRE = '',
    COMM_PARA = """
            Total Mass / Inertia (ALL)
            ==========================\n""",
    UNITE = 8, 
);

