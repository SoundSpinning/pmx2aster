# Generate Submodel constraints
sub_fix_5 = AFFE_CHAR_MECA(MODELE = sub_model_assy, CHAMNO_IMPO = _F(CHAM_NO = sub_disp_5, COEF_IMPO = 1.0),);
    
multi_LC = MECA_STATIQUE( 
