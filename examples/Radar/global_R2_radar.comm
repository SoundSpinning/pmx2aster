# -----
# LOADS: 
# -----
load_STEP_1 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    FORCE_NODALE = (
        _F(
            GROUP_NO = 'RP_load',
            FX = 1000,
        ),
    ),
);

load_STEP_2 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    FORCE_NODALE = (
        _F(
            GROUP_NO = 'RP_load',
            FY = 1000,
        ),
    ),
);

load_STEP_3 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    FORCE_NODALE = (
        _F(
            GROUP_NO = 'RP_load',
            FZ = 1000,
        ),
    ),
);

load_STEP_4 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    FORCE_NODALE = (
        _F(
            GROUP_NO = 'RP_load',
            MX = 1e4,
        ),
    ),
