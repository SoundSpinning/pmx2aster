            DRY = 0,
        ),
        _F(
            GROUP_NO = 'N1',
            DRZ = 0,
        ),
    ),
);

# -----
# LOADS: 
# -----
load_STEP_1 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    FORCE_NODALE = (
        _F(
            GROUP_NO = 'N3',
            FX = 44.7213595499958,
        ),
    ),
);

load_STEP_2 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    FORCE_NODALE = (
        _F(
            GROUP_NO = 'N3',
            FY = 44.7213595499958,
        ),
    ),
);

load_STEP_3 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    FORCE_NODALE = (
        _F(
            GROUP_NO = 'N3',
            FZ = 44.7213595499958,
        ),
    ),
);

load_STEP_4 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    FORCE_NODALE = (
        _F(
            GROUP_NO = 'N3',
            MX = 447.213,
        ),
    ),
);

load_STEP_5 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    FORCE_NODALE = (
        _F(
            GROUP_NO = 'N3',
            MY = 447.213,
        ),
    ),
);

load_STEP_6 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    FORCE_NODALE = (
        _F(
            GROUP_NO = 'N3',
            MZ = 447.213,
        ),
    ),
);

load_STEP_7 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    PESANTEUR = _F(
        # GROUP_MA = elem_set,  ## default: apply to all, inc. point-masses
        GRAVITE = 50000,
        DIRECTION = (1, 0, 0),
    ),
);

load_STEP_8 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    PESANTEUR = _F(
        # GROUP_MA = elem_set,  ## default: apply to all, inc. point-masses
        GRAVITE = 50000,
        DIRECTION = (0, 1, 0),
    ),
);

load_STEP_9 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    PESANTEUR = _F(
        # GROUP_MA = elem_set,  ## default: apply to all, inc. point-masses
        GRAVITE = 50000,
        DIRECTION = (0, 0, 1),
    ),
);

 
# --------------------------------------
# STEP_1 to STEP_9: Linear Statics - 9 x loadcases
# --------------------------------------
#
# [ K ] matrix re-use when using a single set of constraints; i.e. fast linear solving.
#
# setup AMPLITUDE curves (tables) for solve time increments, period and each of the loadcases
#             -------------
# Setup solve time stepping (increments):
#             -------------
step_incs = DEFI_LIST_REEL (
    TITRE = 'step_incs',
    DEBUT = 1,
    INTERVALLE = 
        _F(
            JUSQU_A = 9 , ## time period
            PAS = 1,   ## time increment
        ),
    INFO = 2,
);

# ----------------
# AMPLITUDE curves for each load vs step_incs:
# ----------------
amp_load_STEP_1 = DEFI_FONCTION (
    TITRE = 'load_STEP_1',
    NOM_PARA = "INST",
    VALE = (
        0, 0,
        1, 1,
        2, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_2 = DEFI_FONCTION (
    TITRE = 'load_STEP_2',
    NOM_PARA = "INST",
    VALE = (
        1, 0,
        2, 1,
        3, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_3 = DEFI_FONCTION (
    TITRE = 'load_STEP_3',
    NOM_PARA = "INST",
    VALE = (
        2, 0,
        3, 1,
        4, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_4 = DEFI_FONCTION (
    TITRE = 'load_STEP_4',
    NOM_PARA = "INST",
    VALE = (
        3, 0,
        4, 1,
        5, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_5 = DEFI_FONCTION (
    TITRE = 'load_STEP_5',
    NOM_PARA = "INST",
    VALE = (
        4, 0,
        5, 1,
        6, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_6 = DEFI_FONCTION (
    TITRE = 'load_STEP_6',
    NOM_PARA = "INST",
    VALE = (
        5, 0,
        6, 1,
        7, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_7 = DEFI_FONCTION (
    TITRE = 'load_STEP_7',
    NOM_PARA = "INST",
    VALE = (
        6, 0,
        7, 1,
        8, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_8 = DEFI_FONCTION (
    TITRE = 'load_STEP_8',
    NOM_PARA = "INST",
    VALE = (
        7, 0,
        8, 1,
        9, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);

amp_load_STEP_9 = DEFI_FONCTION (
    TITRE = 'load_STEP_9',
    NOM_PARA = "INST",
    VALE = (
        8, 0,
        9, 1,
        10, 0,
    ),
    PROL_GAUCHE = "CONSTANT",
    PROL_DROITE = "CONSTANT",
    INFO = 2,
);


# -------                          -------------
# Statics: [ K ] matrix re-use via MECA_STATIQUE
# -------                          -------------
multi_LC = MECA_STATIQUE(
    MODELE = model_assy,
    CHAM_MATER = materials,
    CARA_ELEM = element_props,     ### add springs, mass/inertia elements and/or SHELL thickness
    EXCIT = (
        _F(CHARGE = fix_STEP_1,),  ### add constraints
        _F(CHARGE = load_STEP_1, TYPE_CHARGE = 'FIXE_CSTE', FONC_MULT = amp_load_STEP_1),
        _F(CHARGE = load_STEP_2, TYPE_CHARGE = 'FIXE_CSTE', FONC_MULT = amp_load_STEP_2),
        _F(CHARGE = load_STEP_3, TYPE_CHARGE = 'FIXE_CSTE', FONC_MULT = amp_load_STEP_3),
        _F(CHARGE = load_STEP_4, TYPE_CHARGE = 'FIXE_CSTE', FONC_MULT = amp_load_STEP_4),
        _F(CHARGE = load_STEP_5, TYPE_CHARGE = 'FIXE_CSTE', FONC_MULT = amp_load_STEP_5),
        _F(CHARGE = load_STEP_6, TYPE_CHARGE = 'FIXE_CSTE', FONC_MULT = amp_load_STEP_6),
        _F(CHARGE = load_STEP_7, TYPE_CHARGE = 'FIXE_CSTE', FONC_MULT = amp_load_STEP_7),
        _F(CHARGE = load_STEP_8, TYPE_CHARGE = 'FIXE_CSTE', FONC_MULT = amp_load_STEP_8),
        _F(CHARGE = load_STEP_9, TYPE_CHARGE = 'FIXE_CSTE', FONC_MULT = amp_load_STEP_9),
        ),
    LIST_INST = step_incs,         ### time stepping, n_LCs to solve
    OPTION = 'SANS',               ### turn off gaussian points results, see CALC_CHAMP
    ### turn off auto checks, get results for debugging
    SOLVEUR = _F( 
        RESI_RELA = -1, STOP_SINGULIER = 'NON',
        METHODE='MUMPS', GESTION_MEMOIRE = 'AUTO',
        PCENT_PIVOT = 10, NPREC = 8,   ### default: NPREC=8 | it handles duplicate constraints!
    ),
    ### defaults: SOLVEUR=_F( RESI_RELA = 1e-06, STOP_SINGULIER = 'OUI',),  
    TITRE = 'multi_LCs',
);

# User results added + disps by default:  [ rmed binary rslts file ]:
multi_LC = CALC_CHAMP(
    reuse = multi_LC,
    RESULTAT = multi_LC,
    #   GROUP_MA = assy_els ,  ## default write all
    ### OUTPUT types in code_aster: ('*_ELNO', '*_NOEU', '*_ELGA')
    # Use *_NOEU, so it works in Paraview.
    # Nodal stress / forces at nodes
    CONTRAINTE = ('SIEF_NOEU'),            ### add 'SIGM_ELNO' if SHELLS
    ## Nodal stress invariants: von Mises, etc.
    CRITERES = ('SIEQ_NOEU', ),            ### add 'SIEQ_ELNO' if SHELLS
    # Nodal reactions / forces
    FORCE = ('REAC_NODA', 'FORC_NODA'),
    ## 
    ## for strains; if needed.
    # DEFORMATION = ('EPSI_ELGA', 'EPSI_ELNO', ),
    # for PLASTIC strains.
    # EPSP_ELGA and EPSP_ELNO
    ## for energies; if needed.
    # ENERGIE = ('ENEL_ELEM', 'ENEL_NOEU', 'ETOT_NOEU'),
    # Last 2 are SE densities at nodes, so it plots in ParaView.
    # Uncomment below if energies required.
    # ENERGIE = ('ENEL_NOEU', ),
);


# -------------
# EXPORT TABLES in results text (.dat) file some results (variable/field labels).
# -------------
# Make sure in advance (with a small model) that you get what you need.
# Comment out the line below to list all variables requested in the analysis, 
# useful for initial checks on outputs.
# If the model is large, consider doing all post-processing in a restart deck off a global `base`.

# INFO_RESU(RESULTAT = multi_LC)

#           ------
# Calculate TOTALs: 
#           ------
# Mass/Inertia & Total Strain Energy (TSE) at assembly level per part (elem_sets).
# These to go into (.dat) text results file, see further down for tables output.

# Mass / Inertia breakdown in assembly, per component (elem sets).
## check run time for large models b4 switching this on for many elem_sets; ALL option is faster.
total_mass = POST_ELEM(
    MASS_INER = ( _F( GROUP_MA = assy_mass, ), ),
    RESULTAT = multi_LC,
    CHAM_MATER = materials,
    CARA_ELEM = element_props,
);

# Total Strain Energy (TSE) breakdown in assembly, per component (elem sets), and per loadcase.
## check run time for large models b4 switching this on.
assy_total_SE = POST_ELEM(
    ENER_POT = _F( TOUT = "OUI", ),
    RESULTAT = multi_LC,
    CHAM_MATER = materials,
    CARA_ELEM = element_props,
);

total_SE = POST_ELEM(
    ENER_POT = _F( GROUP_MA = assy_ener, ),
    RESULTAT = multi_LC,
    CHAM_MATER = materials,
    CARA_ELEM = element_props,
);

# This is just a test on all nodes in model, since sometimes the sum on node sets doesn't make sense.
## check run time for large models b4 switching this on.
all_sum_reactions = POST_RELEVE_T(
    ACTION=_F(
        INTITULE = 'ALL TOTAL RF & RM',
        GROUP_NO = 'all_nodes',
        RESULTAT = multi_LC,
        NOM_CHAM = 'REAC_NODA',
        TOUT_ORDRE = 'OUI',
        RESULTANTE = dof_3,
        MOMENT = ('DRX' ,'DRY' ,'DRZ' , ),
        ## Location wrt which the moments are calculated
        POINT = ( 0 , 0 , 50 , ),
        OPERATION = 'EXTRACTION',
    ),
);

# -------------
# TABLES export
# -------------
# CHECK that all units make sense vs expected Mass/Inertias
IMPR_TABLE (
    TABLE = total_mass,
    NOM_PARA = table_mass,
    FORMAT_R = 'G12.5',
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
            Total Mass / Inertia (ALL)
            ==========================\n""",
    UNITE = 8, 
);

IMPR_TABLE (
    TABLE = assy_total_SE,
    FORMAT_R = 'G12.5',
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
            ASSY - Total Strain Energy - Statics (TSE)
            ==========================================\n""",
    UNITE = 8, 
);

IMPR_TABLE (
    TABLE = total_SE,
    FORMAT_R = 'G12.5',
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
            Total Strain Energy - Statics (TSE - ALL)
            =========================================\n""",
    UNITE = 8, 
);

# CHECK on loads over full model being reacted properly:
IMPR_TABLE (
    TABLE = all_sum_reactions,
    NOM_PARA = table_sums_6,
    FORMAT_R = 'G12.5',
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
            ALL nodes, Total Sum of Reactions: Forces & Moments
            ===================================================\n""",
    UNITE = 8, 
);

# SUM of ALL input forces/moments per DoF.
sum_loads = POST_RELEVE_T(
    ACTION=_F(
        INTITULE = 'TOTAL F & M',
        GROUP_NO = load_all,
        RESULTAT = multi_LC,
        NOM_CHAM = 'FORC_NODA',
        TOUT_ORDRE = 'OUI',
        RESULTANTE = dof_3,
        MOMENT = ('DRX' ,'DRY' ,'DRZ' , ),
        ## Location wrt which the moments are calculated
        POINT = ( 0 , 0 , 50 , ),
        OPERATION = 'EXTRACTION',
    ),
);

load_disp = POST_RELEVE_T(
    ACTION=_F(
        INTITULE = 'Disps / Rots',
        GROUP_NO = load_sets,
        RESULTAT = multi_LC,
        NOM_CHAM = 'DEPL',
        NOM_CMP = dof_6,
        OPERATION = 'EXTRACTION',
    ),
);

# -------------
# TABLES export
# -------------
# FEA models should be loaded via reference nodes on couplings, when aplicable,
# so one ref node per load location; i.e. small tables.
# Handy for quick stiffness hand calcs at loaded nodes.
IMPR_TABLE (
    TABLE = load_disp,
    NOM_PARA = table_dof_6,
    FORMAT_R = 'G12.5',
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
            Displacements (mm) & Rotations (rad) @ load node(s)
            ===================================================\n""",
    UNITE = 8, 
);

# CHECK on sum of input Loads vs Reactions table:
IMPR_TABLE (
    TABLE = sum_loads,
    NOM_PARA = table_sums_6,
    FORMAT_R = 'G12.5',
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
            Total Sum: Input Forces & Moments
            =================================\n""",
    UNITE = 8, 
);

# SUM of ALL reaction forces/moments for all node sets constrained and per DoF.
sum_reactions = POST_RELEVE_T(
    ACTION=_F(
        INTITULE = 'TOTAL RF & RM',
        GROUP_NO = fix_all,
        RESULTAT = multi_LC,
        NOM_CHAM = 'REAC_NODA',
        TOUT_ORDRE = 'OUI',
        RESULTANTE = dof_3,
        MOMENT = ('DRX' ,'DRY' ,'DRZ' , ),
        ## Location wrt which the moments are calculated
        POINT = ( 0 , 0 , 50 , ),
        OPERATION = 'EXTRACTION',
    ),
);

# -------------
# TABLES export
# -------------
# CHECK on loads being reacted properly in Statics:
IMPR_TABLE (
    TABLE = sum_reactions,
    NOM_PARA = table_sums_6,
    FORMAT_R = 'G12.5',
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
            Total Sum of Reactions on sets: Forces & Moments
            ================================================\n""",
    UNITE = 8, 
);


# 
# Post results HACK (very ugly!) 
# MED --> PV results so that deformed shapes + any results on assemblies can be plotted.
# 
all_steps = multi_LC.LIST_PARA()['NUME_ORDRE'];
print(all_steps);
time_steps = multi_LC.LIST_PARA()['INST'];
print(time_steps);

# Combine all stresses into a single field, 
# so that Paraview can plot deformed shapes + any Stress variable.
#                      ---------------------------------
asse_list = []

# for inc in range(len(all_steps)):
for inc in all_steps:
    # time = time_steps[inc-1] ##  for MECA_STATIQUE steps
    # time = time_steps[inc]   ##  for STAT_NON_LIN steps; dunno why, but code_aster changes loadcase ID integers!
    time = time_steps[inc-1]
    try:
        ## Extract stress tensor & elem forces at all nodes
        sief = multi_LC.getField('SIEF_NOEU', inc)
        ## Extract von Mises, etc stress fields - some nodes
        # sieq = multi_LC.getField('SIEQ_NOEU', inc)
        ## Extract shells stress fields
        # s_sief = sh_sief.getField('SIGM_NOEU', inc)
        # s_sieq = sh_sieq.getField('SIEQ_NOEU', inc)
        
        # Combine all stress vars into one field
        s_all = CREA_CHAMP(
            OPERATION = 'ASSE',
            TYPE_CHAM = 'NOEU_SIEF_R',
            MAILLAGE = mesh,
            ASSE=(
                _F(CHAM_GD = sief, TOUT = 'OUI', CUMUL='OUI', COEF_R=1.0, ),  
                # _F(CHAM_GD = sieq, TOUT = 'OUI', CUMUL='OUI', COEF_R=1.0, ),
                ## SHELLS
                # _F(CHAM_GD = s_sief, TOUT = 'OUI', CUMUL='OUI', COEF_R=1.0, ),
                # _F(CHAM_GD = s_sieq, TOUT = 'OUI', CUMUL='OUI', COEF_R=1.0, ),
            ),
        );
        # Add to ASSE list
        asse_list.append(_F(CHAM_GD = s_all, INST = time, MODELE = model_assy, ))
    except Exception as e:
        print(f'Error at step {time}: {e}')
        continue

# the copy of the results concept is required if we need a 'base' for restarts.
# if we leave the post calcs below inside `multi_LC`, any restart after will crash.
# there you go, the fun of working with code_aster, crazy ...
post_multi_LC = COPIER (CONCEPT = multi_LC);

# Merge results
post_multi_LC = CREA_RESU(
    reuse = post_multi_LC,
    RESULTAT = post_multi_LC,
    OPERATION = 'AFFE',
    TYPE_RESU = 'EVOL_NOLI',
    NOM_CHAM = "SIEF_NOEU",
    AFFE = tuple(asse_list),
);

# Results variable names:
s_vars = ('SIXX', 'SIYY', 'SIZZ', 'SIXY', 'SIXZ', 'SIYZ', 'VMIS', 'VMIS_SG', );    
      ## ('TRESCA', 'PRIN_1', 'PRIN_2', 'PRIN_3', );

# ------
# EXPORT STATIC (MED) results --> binary (.rmed) file, reads in Paraview.
# ------
IMPR_RESU(
    FORMAT = "MED",
    UNITE = 80,
    RESU = (
        _F( RESULTAT = post_multi_LC, 
            NOM_RESU_MED = '1_Stat',
            NOM_CHAM = ('DEPL', ),
            # NOM_CHAM = ('DEPL', 'REAC_NODA', 'FORC_NODA', ),
          ),
        # _F( RESULTAT = post_multi_LC, 
        #     NOM_RESU_MED = '1_Stat',
        #     NOM_CHAM = ('SIEF_NOEU'),
        #     NOM_CMP = s_vars
        #   ),
    ),
);

# not needed in the 'base' results, so delete.
DETRUIRE(NOM = (post_multi_LC, s_all, sief, ));


# ----------------------
# STEP_10: Modal Analysis
# ----------------------

# Setting the right matrices for a modal STEP
ASSEMBLAGE(
    MODELE = model_assy,
    CHAM_MATER = materials, 
    CARA_ELEM = element_props,
    CHARGE = (fix_STEP_1, ),
    ### use below for a free-free modal; i.e. check for 6 RBModes at ~0Hz.
    # CHARGE = (),  
    MATR_ASSE = (
        _F( MATRICE = CO('MASS'), OPTION = "MASS_MECA", ),
        _F( MATRICE = CO('RIGI'), OPTION = "RIGI_MECA", ),
    ),
    NUME_DDL = CO('numdof'),
);

# Modal analysis setup
modes = CALC_MODES(
    MATR_RIGI = RIGI,
    MATR_MASS = MASS,
    OPTION = "PLUS_PETITE",
    CALC_FREQ = _F( 
        NMAX_FREQ = 6,       ### Number of modes
        NMAX_ITER_SHIFT = 3,
        PREC_SHIFT = 0.05,
        ### Below Important! to capture negative (~0Hz) rigid body modes.
        SEUIL_FREQ = 10,     ### Shift freq parameter, will turn to -10 in solve.
    ),
    SOLVEUR_MODAL = _F( METHODE = 'SORENSEN') ,    ### faster than Lanczos
    # SOLVEUR_MODAL = _F( METHODE = 'TRI_DIAG', MODE_RIGIDE = 'OUI',) ,   ### Lanczos solver
    SOLVEUR = _F(
        RESI_RELA = -1, NB_RHS = 10,
        METHODE='MUMPS', GESTION_MEMOIRE = 'AUTO', PCENT_PIVOT = 10, 
    ),
    VERI_MODE = _F(
        PREC_SHIFT = 0.05, SEUIL = 1e-06,
        STOP_ERREUR = 'NON', STURM = 'NON', 
    ),
    STOP_BANDE_VIDE = 'NON',
);

# Calculate Total_SE (TSE) per component (elem set), per mode.
mod_total_SE = POST_ELEM(
    ENER_POT = _F( GROUP_MA = assy_ener , ),
    RESULTAT = modes,
);

# Export results --> table in text (.dat) file
# Natural Freqs (Hz) + modal participation factors...
mod_table = RECU_TABLE (
   CO = modes,
   NOM_PARA = table_modal_out,
   TITRE = 'Modal Results Table',
);

IMPR_TABLE (
    TABLE = mod_table,
    FORMAT_R = 'G12.5', 
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
    Modal (Freqs(Hz), Participation Factors, Effective Mass)
    ========================================================\n""",
    UNITE = 8, 
);

IMPR_TABLE (
    TABLE = mod_total_SE,
    FORMAT_R = 'G12.5', 
    SEPARATEUR = ', ',
    COMMENTAIRE = '',
    COMM_PARA = """
            Total Strain Energy - Modal (TSE - ALL)
            =======================================\n""",
    UNITE = 8, 
);

# export results --> binary .rmed file
IMPR_RESU (
    FORMAT = 'MED', 
    UNITE = 80,
    RESU = _F(
        RESULTAT = modes, 
        NOM_CHAM = 'DEPL', 
        NOM_CHAM_MED='2_Modal',
    ),
);


# ===
# END of the input deck
# ===
FIN();
