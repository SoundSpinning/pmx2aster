            DRY = 0,
        ),
        _F(
            GROUP_NO = 'N1',
            DRZ = 0,
        ),
    ),
);

fix_STEP_9 = AFFE_CHAR_MECA(
    MODELE = model_assy,
    DDL_IMPO = (
        _F(
            GROUP_NO = 'N1',
            DX = 0,
        ),
        _F(
            GROUP_NO = 'N1',
            DY = 0,
        ),
        _F(
